# Copy this file to .env and fill in your key:   cp .env.example .env
# .env is gitignored. This file is safe to commit.

# ---------------------------------------------------------------------------
# Memory backend: where your memories are stored
#
#   cloud (default) - mem0's hosted API. Simplest: nothing is downloaded, no
#                     local vector store, and memory extraction runs on mem0's
#                     servers rather than against your Gemini quota.
#                     Trade-off: your conversations are sent to and stored on
#                     mem0's servers, and the free tier has a cap.
#
#   oss             - everything on this machine: sentence-transformers on CPU
#                     for embeddings + Qdrant on disk. Nothing leaves the
#                     machine and there is no account cap. Costs a one-time
#                     ~90MB model download and ~3 LLM calls per turn against
#                     your own key.
# ---------------------------------------------------------------------------
MEMORY_BACKEND=cloud

# Needed only when MEMORY_BACKEND=cloud.
# Sign up at https://app.mem0.ai - the free Hobby tier needs no credit card.
# The key is under Settings -> API Keys.
MEM0_API_KEY=

# ---------------------------------------------------------------------------
# LLM backend: "gemini" (default, free tier, needs a key) or "ollama" (offline)
# This is the model that writes your replies. It is used in BOTH memory
# backends, because answering you is separate from remembering you.
# ---------------------------------------------------------------------------
BACKEND=gemini

# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Flash-lite tier. One chat turn costs ~3 LLM calls (1 reply + 2 for mem0's
# extract/reconcile), so daily quota matters more than raw model quality.
#
# Free quota is counted PER MODEL, and the allowances differ enormously -
# gemini-2.5-flash reports only 20 requests/day (~6 chat turns), while the
# lite models give you far more. If you exhaust one model, just name another
# here: `python check_setup.py --list-models` shows what your key can call.
GEMINI_MODEL=gemini-3.5-flash-lite

# Only used when BACKEND=ollama. Install from https://ollama.com then:
#   ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings - local, CPU, free forever. Not affected by BACKEND.
# ---------------------------------------------------------------------------
# all-MiniLM-L6-v2 produces 384-dim vectors. Changing the model without
# changing this number makes every Qdrant insert fail.

# ---------------------------------------------------------------------------
# Embeddings
#
#   huggingface (default) - all-MiniLM-L6-v2 on your CPU. Free forever, fully
#                           offline, but needs `pip install -r requirements-local.txt`
#                           (torch, ~1GB) and a one-time ~90MB download.
#
#   gemini                - embeds through the same free API key used for
#                           replies. Nothing downloaded, starts instantly.
#                           This is what deployments use.
#
# Leave EMBEDDING_MODEL and EMBEDDING_DIMS unset and each provider picks its
# own correct pair. Setting them by hand is how you end up asking a Gemini
# client for a sentence-transformers checkpoint.
#
# A Qdrant collection's vector width is fixed at creation, so switching
# provider also means switching QDRANT_COLLECTION.
# ---------------------------------------------------------------------------
EMBEDDER_PROVIDER=huggingface
# EMBEDDING_MODEL=
# EMBEDDING_DIMS=

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
QDRANT_COLLECTION=agent_memory
QDRANT_PATH=./qdrant_data

# Leave QDRANT_HOST empty for local (embedded, single-process) mode.
# Set it to "localhost" after `docker compose up -d` to use a real server,
# which is what you want as soon as two processes need memory at once.
QDRANT_HOST=
QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# How many recalled memories get injected into the system prompt each turn.
RECALL_LIMIT=5
# Print recalled memories and memory operations in dim grey. Toggle at runtime
# with /quiet.
DEBUG=true
# Retries for Gemini 429 rate-limit responses, with exponential backoff.
MAX_RETRIES=5

# ---------------------------------------------------------------------------
# Deployment only - ignore these for local use
# ---------------------------------------------------------------------------
# Qdrant Cloud (https://cloud.qdrant.io, free 1GB tier). Takes precedence over
# both local mode and QDRANT_HOST. A serverless function has no persistent
# disk, so a managed cluster is the only option that survives a redeploy.
QDRANT_URL=
QDRANT_API_KEY=

# Safety rails for a publicly reachable deployment: server-issued memory
# scopes so visitors cannot read each other's facts, a per-visitor rate limit,
# and a daily ceiling so one free-tier key cannot be drained by a link.
DEMO_MODE=false
DEMO_VISITOR_LIMIT=12
DEMO_DAILY_BUDGET=300
